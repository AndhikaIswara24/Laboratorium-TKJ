generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GURU
  SISWA
}

enum ItemCondition {
  GOOD
  MINOR_DAMAGE
  MAJOR_DAMAGE
  BROKEN
  LOST
}

enum BorrowStatus {
  PENDING
  APPROVED
  RETURNED
  REJECTED
  OVERDUE
}

enum EvaluationResult {
  USABLE
  NEEDS_REPAIR
  NOT_USABLE
}

model User {
  id            String      @id @default(uuid())
  name          String
  email         String      @unique
  password      String      // Hashed password
  role          Role        @default(SISWA)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  borrowings    Borrowing[]
  monitorings   Monitoring[]
}

model InventoryItem {
  id            String      @id @default(uuid())
  code          String      @unique // Kode registrasi unik barang
  name          String
  description   String?
  category      String
  quantity      Int         @default(1)
  condition     ItemCondition @default(GOOD)
  conditionScore Int        @default(5) // Skala 1-5: kondisi fisik barang
  repairsCount  Int        @default(0) // Jumlah perbaikan yang pernah dilakukan
  qrCodeUrl     String?     // URL/Data string untuk QR Code
  acquisitionDate DateTime  @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  borrowings    Borrowing[]
  monitorings   Monitoring[]
  evaluations   NaiveBayesEvaluation[]
}

model Borrowing {
  id            String      @id @default(uuid())
  userId        String
  itemId        String
  quantity      Int         @default(1)
  borrowDate    DateTime    @default(now())
  expectedReturnDate DateTime
  actualReturnDate   DateTime?
  status        BorrowStatus @default(PENDING)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id])
  item          InventoryItem @relation(fields: [itemId], references: [id])
}

model Monitoring {
  id            String      @id @default(uuid())
  itemId        String
  checkedById   String      
  checkDate     DateTime    @default(now())
  condition     ItemCondition
  notes         String?
  
  item          InventoryItem @relation(fields: [itemId], references: [id])
  checkedBy     User        @relation(fields: [checkedById], references: [id])
}

model NaiveBayesEvaluation {
  id               String      @id @default(uuid())
  itemId           String
  evaluationDate   DateTime    @default(now())
  
  ageInYears       Float       // Umur barang dalam tahun
  frequencyPerMonth Int        // Frekuensi penggunaan per bulan
  repairsCount     Int         // Jumlah perbaikan yang pernah dilakukan
  conditionScore   Int         // Skala 1-5: kondisi fisik barang

  result           EvaluationResult
  probability      Float       // Confidence score (0-1)
  usableProbability Float      // Probabilitas USABLE
  needsRepairProbability Float  // Probabilitas NEEDS_REPAIR
  notUsableProbability Float    // Probabilitas NOT_USABLE

  item             InventoryItem @relation(fields: [itemId], references: [id])
}

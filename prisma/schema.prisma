generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GURU
  SISWA
}

enum ItemCondition {
  GOOD
  MINOR_DAMAGE
  MAJOR_DAMAGE
  BROKEN
  LOST
}

enum BorrowStatus {
  PENDING
  APPROVED
  RETURNED
  REJECTED
  OVERDUE
}

enum EvaluationResult {
  FEASIBLE
  UNFEASIBLE
}

model User {
  id            String      @id @default(uuid())
  name          String
  email         String      @unique
  password      String      // Hashed password
  role          Role        @default(SISWA)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  borrowings    Borrowing[]
  monitorings   Monitoring[]
}

model InventoryItem {
  id            String      @id @default(uuid())
  code          String      @unique // Kode registrasi unik barang
  name          String
  description   String?
  category      String
  quantity      Int         @default(1)
  condition     ItemCondition @default(GOOD)
  qrCodeUrl     String?     // URL/Data string untuk QR Code
  acquisitionDate DateTime  @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  borrowings    Borrowing[]
  monitorings   Monitoring[]
  evaluations   NaiveBayesEvaluation[]
}

model Borrowing {
  id            String      @id @default(uuid())
  userId        String
  itemId        String
  borrowDate    DateTime    @default(now())
  expectedReturnDate DateTime
  actualReturnDate   DateTime?
  status        BorrowStatus @default(PENDING)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id])
  item          InventoryItem @relation(fields: [itemId], references: [id])
}

model Monitoring {
  id            String      @id @default(uuid())
  itemId        String
  checkedById   String      
  checkDate     DateTime    @default(now())
  condition     ItemCondition
  notes         String?
  
  item          InventoryItem @relation(fields: [itemId], references: [id])
  checkedBy     User        @relation(fields: [checkedById], references: [id])
}

model NaiveBayesEvaluation {
  id               String   @id @default(uuid())
  itemId           String
  evaluationDate   DateTime @default(now())
  
  frequencyOfUse   Int      // Seberapa sering dipinjam/digunakan
  ageInMonths      Int      // Umur barang sejak diakuisisi
  previousCondition ItemCondition

  result           EvaluationResult
  probability      Float    

  item             InventoryItem @relation(fields: [itemId], references: [id])
}
